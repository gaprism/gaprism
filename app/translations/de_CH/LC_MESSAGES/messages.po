#: app/blueprints/accounts/forms.py
msgid "Enter a new password."
msgstr "Geben Sie ein neues Passwort ein."

#: app/blueprints/accounts/forms.py
#, python-format
msgid "The password has more than %(max)d characters. Use a shorter one."
msgstr "Das Passwort hat mehr als %(max)d Zeichen. Verwenden Sie ein kürzeres."

#: app/blueprints/accounts/forms.py
msgid "Enter the same password again."
msgstr "Geben Sie dasselbe Passwort noch einmal ein."

#: app/blueprints/accounts/forms.py
#, python-format
msgid "An e-mail address has at most %(max)d characters. Check what you entered."
msgstr "Eine E-Mail-Adresse hat höchstens %(max)d Zeichen. Prüfen Sie Ihre Eingabe."

#: app/blueprints/accounts/forms.py app/blueprints/accounts/views.py
msgid "Enter the e-mail address of the person to invite."
msgstr "Geben Sie die E-Mail-Adresse der Person ein, die Sie einladen möchten."

#: app/blueprints/accounts/invitation_views.py
msgid "This link does not work"
msgstr "Dieser Link funktioniert nicht"

#: app/blueprints/accounts/invitation_views.py
msgid "It may have been used, withdrawn or expired. Ask the person who sent it for a new one."
msgstr ""
"Er wurde möglicherweise schon verwendet, zurückgezogen oder ist abgelaufen. Bitten Sie die "
"Person, die ihn geschickt hat, um einen neuen."

#: app/blueprints/accounts/invitation_views.py
msgid "The two passwords are not the same. Enter the same password twice."
msgstr "Die beiden Passwörter stimmen nicht überein. Geben Sie zweimal dasselbe Passwort ein."

#: app/blueprints/accounts/invitation_views.py
msgid "Password set. Sign in to finish setting up."
msgstr "Passwort gesetzt. Melden Sie sich an, um die Einrichtung abzuschliessen."

#: app/blueprints/accounts/views.py
msgid ""
"An account for this e-mail address exists already. Use its row in the list below to send it a new"
" link."
msgstr ""
"Für diese E-Mail-Adresse besteht bereits ein Konto. Verwenden Sie dessen Zeile in der Liste "
"unten, um ihm einen neuen Link zu schicken."

#: app/blueprints/accounts/views.py
#, python-format
msgid "Withdrew the link of %(email)s."
msgstr "Der Link von %(email)s wurde zurückgezogen."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s has no working link."
msgstr "%(email)s hat keinen gültigen Link."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is switched on already."
msgstr "%(email)s ist bereits eingeschaltet."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is switched off already."
msgstr "%(email)s ist bereits ausgeschaltet."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is switched on again."
msgstr "%(email)s ist wieder eingeschaltet."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is switched off. Their sessions end with their next request."
msgstr "%(email)s ist ausgeschaltet. Die Sitzungen dieser Person enden mit der nächsten Anfrage."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is an administrator."
msgstr "%(email)s ist jetzt Admin."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is one already."
msgstr "%(email)s ist bereits Admin."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is not an administrator any more."
msgstr "%(email)s ist kein Admin mehr."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is not an administrator."
msgstr "%(email)s ist kein Admin."

#: app/blueprints/accounts/views.py
#, python-format
msgid "%(email)s is signed out everywhere."
msgstr "%(email)s ist überall abgemeldet."

#: app/blueprints/assessments/exports.py
msgid "Export a scan once it has finished."
msgstr "Exportieren Sie einen Scan, sobald er abgeschlossen ist."

#: app/blueprints/assessments/forms.py
msgid "Choose who can see the assessment."
msgstr "Wählen Sie, wer das Assessment sehen kann."

#: app/blueprints/assessments/forms.py
#, python-format
msgid "A domain name has at most %(max)d characters. Check what you entered."
msgstr "Eine Domain hat höchstens %(max)d Zeichen. Prüfen Sie Ihre Eingabe."

#: app/blueprints/assessments/forms.py
#, python-format
msgid "The label has more than %(max)d characters. Shorten it."
msgstr "Die Bezeichnung hat mehr als %(max)d Zeichen. Kürzen Sie sie."

#: app/blueprints/assessments/history.py
msgid "Choose two different scans to compare."
msgstr "Wählen Sie zwei verschiedene Scans zum Vergleichen."

#: app/blueprints/assessments/views.py
msgid "This domain already has an assessment. Open that one instead."
msgstr "Für diese Domain gibt es bereits ein Assessment. Öffnen Sie stattdessen dieses."

#: app/blueprints/assessments/views.py
msgid "Assessment created."
msgstr "Assessment erstellt."

#: app/blueprints/assessments/views.py
#, python-format
msgid "A shared assessment for %(domain)s already exists, so this one cannot be shared as well."
msgstr ""
"Für %(domain)s gibt es bereits ein geteiltes Assessment, deshalb kann dieses nicht ebenfalls "
"geteilt werden."

#: app/blueprints/assessments/views.py
msgid "Shared with everyone here: every signed-in user can open it."
msgstr "Mit allen hier geteilt: Alle angemeldeten Personen können es öffnen."

#: app/blueprints/assessments/views.py
msgid "Now private: only the owner and the administrators can open it."
msgstr "Jetzt privat: Nur die zuständige Person und die Admins können es öffnen."

#: app/blueprints/assessments/views.py
msgid "This assessment is archived and read-only. Restore it to change it."
msgstr "Dieses Assessment ist archiviert und schreibgeschützt. Stellen Sie es wieder her, um es zu ändern."

#: app/blueprints/assessments/views.py
msgid "A scan is queued or running for this assessment. Cancel it, or wait for it, before archiving it."
msgstr ""
"Für dieses Assessment ist ein Scan in der Warteschlange oder läuft. Brechen Sie ihn ab oder "
"warten Sie, bis er fertig ist, bevor Sie es archivieren."

#: app/blueprints/assessments/views.py
msgid "Archived. It is hidden from the list: the Archived tab has it, and you can restore it."
msgstr ""
"Archiviert. Es ist in der Liste ausgeblendet: Der Reiter «Archiviert» zeigt es, und Sie können es"
" wiederherstellen."

#: app/blueprints/assessments/views.py
msgid "Restored from the archive."
msgstr "Aus dem Archiv wiederhergestellt."

#: app/blueprints/assessments/views.py
msgid "That is not the domain, so nothing was deleted."
msgstr "Das ist nicht die Domain, deshalb wurde nichts gelöscht."

#: app/blueprints/assessments/views.py
msgid "A scan is queued or running for this assessment. Cancel it, or wait for it, before deleting it."
msgstr ""
"Für dieses Assessment ist ein Scan in der Warteschlange oder läuft. Brechen Sie ihn ab oder "
"warten Sie, bis er fertig ist, bevor Sie es löschen."

#: app/blueprints/assessments/views.py
#, python-format
msgid "Deleted %(domain)s."
msgstr "%(domain)s gelöscht."

#: app/blueprints/assessments/views.py
msgid "A scan is already queued or running for this assessment."
msgstr "Für dieses Assessment ist bereits ein Scan in der Warteschlange oder läuft."

#: app/blueprints/assessments/views.py
#, python-format
msgid ""
"You have started the most scans allowed in an hour (%(count)s). The next one can start in about "
"%(num)s minute."
msgid_plural ""
"You have started the most scans allowed in an hour (%(count)s). The next one can start in about "
"%(num)s minutes."
msgstr[0] ""
"Sie haben die in einer Stunde erlaubte Höchstzahl an Scans gestartet (%(count)s). Der nächste "
"kann in etwa %(num)s Minute starten."
msgstr[1] ""
"Sie haben die in einer Stunde erlaubte Höchstzahl an Scans gestartet (%(count)s). Der nächste "
"kann in etwa %(num)s Minuten starten."

#: app/blueprints/assessments/views.py
msgid "Scan queued."
msgstr "Scan in die Warteschlange gestellt."

#: app/blueprints/assessments/views.py
msgid "Scan cancelled. Checks that were already running will finish."
msgstr "Scan abgebrochen. Prüfungen, die bereits laufen, werden noch beendet."

#: app/blueprints/assessments/views.py
msgid "There is no running scan to cancel."
msgstr "Es läuft kein Scan, der abgebrochen werden könnte."

#: app/blueprints/assessments/views.py
msgid "Finding reopened."
msgstr "Befund wieder geöffnet."

#: app/blueprints/assessments/views.py
msgid "This finding was already open."
msgstr "Dieser Befund war bereits offen."

#: app/blueprints/assessments/views.py
msgid "Finding accepted."
msgstr "Befund akzeptiert."

#: app/blueprints/assessments/views.py
msgid "Finding marked as a false positive."
msgstr "Befund als False Positive markiert."

#: app/blueprints/assessments/views.py
#, python-format
msgid "%(count)s host(s) added. They are included in the next scan."
msgstr "%(count)s Host(s) hinzugefügt. Sie sind im nächsten Scan enthalten."

#: app/blueprints/assessments/views.py
#, python-format
msgid "Already included: %(hosts)s"
msgstr "Bereits enthalten: %(hosts)s"

#: app/blueprints/assessments/views.py
#, python-format
msgid "Not added: %(host)s (%(reason)s)"
msgstr "Nicht hinzugefügt: %(host)s (%(reason)s)"

#: app/blueprints/assessments/views.py
msgid "Enter at least one hostname."
msgstr "Geben Sie mindestens einen Hostnamen ein."

#: app/blueprints/assessments/views.py
#, python-format
msgid "Removed %(host)s."
msgstr "%(host)s entfernt."

#: app/blueprints/profile/forms.py
msgid "Choose a picture to upload."
msgstr "Wählen Sie ein Bild zum Hochladen aus."

#: app/blueprints/profile/views.py
msgid "Profile saved."
msgstr "Profil gespeichert."

#: app/blueprints/profile/views.py
msgid "Picture saved."
msgstr "Bild gespeichert."

#: app/blueprints/profile/views.py
msgid "Picture removed."
msgstr "Bild entfernt."

#: app/blueprints/profile/views.py
msgid "There is no picture to remove."
msgstr "Es gibt kein Bild zum Entfernen."

#: app/config.py
msgid "The email address or password is not correct. Check them and try again."
msgstr "Die E-Mail-Adresse oder das Passwort stimmt nicht. Prüfen Sie beide und versuchen Sie es erneut."

#: app/config.py
msgid "The code is not correct or has expired. Enter the current code from your authenticator app."
msgstr "Der Code ist falsch oder abgelaufen. Geben Sie den aktuellen Code aus Ihrer Authenticator-App ein."

#: app/config.py
msgid "The sign-in has expired. Enter your email address and password again."
msgstr "Die Anmeldung ist abgelaufen. Geben Sie Ihre E-Mail-Adresse und Ihr Passwort erneut ein."

#: app/config.py
msgid "The current password is not correct. Enter the password you sign in with."
msgstr "Das aktuelle Passwort stimmt nicht. Geben Sie das Passwort ein, mit dem Sie sich anmelden."

#: app/config.py
msgid "The two new passwords are not the same. Enter the same password twice."
msgstr "Die beiden neuen Passwörter stimmen nicht überein. Geben Sie zweimal dasselbe Passwort ein."

#: app/config.py
#, python-format
msgid "The new password is too short. Use at least %(length)s characters."
msgstr "Das neue Passwort ist zu kurz. Verwenden Sie mindestens %(length)s Zeichen."

#: app/config.py
msgid "This field is empty. Enter a password."
msgstr "Dieses Feld ist leer. Geben Sie ein Passwort ein."

#: app/config.py
msgid "The new password is the same as the current one. Choose a different password."
msgstr "Das neue Passwort ist dasselbe wie das aktuelle. Wählen Sie ein anderes Passwort."

#: app/config.py
msgid "Your password has been changed."
msgstr "Ihr Passwort wurde geändert."

#: app/config.py
msgid "Two-factor authentication is turned off."
msgstr "Die Zwei-Faktor-Authentifizierung ist ausgeschaltet."

#: app/config.py
msgid "Two-factor authentication is set up. Use your authenticator app at your next sign-in."
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist eingerichtet. Verwenden Sie Ihre Authenticator-App bei der "
"nächsten Anmeldung."

#: app/config.py
msgid "Your code is confirmed."
msgstr "Ihr Code ist bestätigt."

#: app/config.py
#, python-format
msgid "The setup took too long: it must be finished within %(within)s. Start again."
msgstr ""
"Die Einrichtung hat zu lange gedauert: Sie muss innerhalb von %(within)s abgeschlossen sein. "
"Beginnen Sie von vorn."

#: app/config.py
msgid "That method is not available. Use the authenticator app."
msgstr "Diese Methode ist nicht verfügbar. Verwenden Sie die Authenticator-App."

#: app/config.py
msgid "Enter your password to continue."
msgstr "Geben Sie Ihr Passwort ein, um fortzufahren."

#: app/config.py
msgid "Your password is confirmed."
msgstr "Ihr Passwort ist bestätigt."

#: app/config.py
msgid "You must sign in to view this resource."
msgstr "Sie müssen sich anmelden, um diese Ressource anzuzeigen."

#: app/config.py
msgid "You do not have permission to view this resource."
msgstr "Sie haben keine Berechtigung, diese Ressource anzuzeigen."

#: app/config.py
msgid "You can only access this endpoint when not logged in."
msgstr "Auf diese Seite können Sie nur zugreifen, wenn Sie nicht angemeldet sind."

#: app/config.py
msgid "Account is disabled."
msgstr "Das Konto ist ausgeschaltet."

#: app/config.py
msgid "Specified user does not exist"
msgstr "Das angegebene Konto existiert nicht"

#: app/config.py
msgid "Email not provided"
msgstr "Keine E-Mail-Adresse angegeben"

#: app/config.py
msgid "Invalid email address"
msgstr "Ungültige E-Mail-Adresse"

#: app/config.py
msgid "Redirections outside the domain are forbidden"
msgstr "Weiterleitungen ausserhalb der Domain sind nicht erlaubt"

#: app/rules/domain.py
msgid "No SPF record"
msgstr "Kein SPF-Eintrag"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s publishes no SPF record, so receivers cannot tell forged mail from real."
msgstr ""
"%(domain)s veröffentlicht keinen SPF-Eintrag, deshalb können Empfänger gefälschte E-Mails nicht "
"von echten unterscheiden."

#: app/rules/domain.py
msgid "Publish an SPF record; a domain that sends no mail should say so with `v=spf1 -all`."
msgstr ""
"Veröffentlichen Sie einen SPF-Eintrag; eine Domain, die keine E-Mails versendet, sollte das mit "
"`v=spf1 -all` ausdrücken."

#: app/rules/domain.py
msgid "SPF does not restrict senders"
msgstr "SPF schränkt Absender nicht ein"

#: app/rules/domain.py
#, python-format
msgid ""
"The SPF record of %(domain)s ends in %(ending)s, which does not tell receivers to reject mail "
"from other senders."
msgstr ""
"Der SPF-Eintrag von %(domain)s endet auf %(ending)s; damit werden Empfänger nicht angewiesen, "
"E-Mails anderer Absender abzulehnen."

#: app/rules/domain.py
msgid "End the record with `-all` (or `~all` while rolling it out)."
msgstr "Beenden Sie den Eintrag mit `-all` (oder während der Einführung mit `~all`)."

#: app/rules/domain.py
msgid "Record ends in"
msgstr "Eintrag endet auf"

#: app/rules/domain.py
msgid "SPF record is broken"
msgstr "SPF-Eintrag ist fehlerhaft"

#: app/rules/domain.py
#, python-format
msgid "The SPF record of %(domain)s is invalid for receivers: %(problems)s."
msgstr "Der SPF-Eintrag von %(domain)s ist für Empfänger ungültig: %(problems)s."

#: app/rules/domain.py
msgid "Publish a single SPF record that needs at most 10 DNS lookups."
msgstr "Veröffentlichen Sie genau einen SPF-Eintrag, der höchstens 10 DNS-Abfragen benötigt."

#: app/rules/domain.py
msgid "No DMARC record"
msgstr "Kein DMARC-Eintrag"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s publishes no DMARC policy, so receivers have no instruction for forged mail."
msgstr ""
"%(domain)s veröffentlicht keine DMARC-Richtlinie, deshalb haben Empfänger keine Anweisung für "
"gefälschte E-Mails."

#: app/rules/domain.py
msgid "Publish a DMARC record, starting with `p=none` and reporting, then move to `reject`."
msgstr ""
"Veröffentlichen Sie einen DMARC-Eintrag, beginnen Sie mit `p=none` und Berichten und wechseln Sie"
" dann zu `reject`."

#: app/rules/domain.py
msgid "DMARC only monitors"
msgstr "DMARC überwacht nur"

#: app/rules/domain.py
#, python-format
msgid "The DMARC policy of %(domain)s is `none`: forged mail is reported but still delivered."
msgstr ""
"Die DMARC-Richtlinie von %(domain)s ist `none`: Gefälschte E-Mails werden gemeldet, aber trotzdem"
" zugestellt."

#: app/rules/domain.py
msgid "Once the reports look clean, move the policy to `quarantine` and then `reject`."
msgstr ""
"Wenn die Berichte unauffällig sind, stellen Sie die Richtlinie auf `quarantine` und dann auf "
"`reject`."

#: app/rules/domain.py
msgid "Aggregate reports sent to"
msgstr "Aggregierte Berichte gehen an"

#: app/rules/domain.py
msgid "DMARC record is broken"
msgstr "DMARC-Eintrag ist fehlerhaft"

#: app/rules/domain.py
#, python-format
msgid "The DMARC record of %(domain)s is not valid, so receivers ignore it: %(problems)s."
msgstr "Der DMARC-Eintrag von %(domain)s ist ungültig, deshalb ignorieren Empfänger ihn: %(problems)s."

#: app/rules/domain.py
msgid "Publish a single DMARC record with a valid `p=` policy."
msgstr "Veröffentlichen Sie genau einen DMARC-Eintrag mit einer gültigen `p=`-Richtlinie."

#: app/rules/domain.py
msgid "No MTA-STS policy"
msgstr "Keine MTA-STS-Richtlinie"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s receives mail but publishes no MTA-STS policy, so mail can be downgraded in transit."
msgstr ""
"%(domain)s empfängt E-Mails, veröffentlicht aber keine MTA-STS-Richtlinie, deshalb können E-Mails"
" unterwegs herabgestuft werden."

#: app/rules/domain.py
msgid "Publish an MTA-STS policy (and TLS-RPT reporting) so senders insist on TLS."
msgstr ""
"Veröffentlichen Sie eine MTA-STS-Richtlinie (und TLS-RPT-Berichte), damit Absender auf TLS "
"bestehen."

#: app/rules/domain.py
msgid "DNSSEC is not enabled"
msgstr "DNSSEC ist nicht aktiviert"

#: app/rules/domain.py
#, python-format
msgid "The domain %(domain)s is not signed with DNSSEC."
msgstr "Die Domain %(domain)s ist nicht mit DNSSEC signiert."

#: app/rules/domain.py
msgid "DNSSEC protects DNS answers from forgery; ask whether it is planned."
msgstr "DNSSEC schützt DNS-Antworten vor Fälschung; fragen Sie nach, ob es geplant ist."

#: app/rules/domain.py
msgid "Domain registration expires soon"
msgstr "Domain-Registrierung läuft bald ab"

#: app/rules/domain.py
#, python-format
msgid "The registration of %(domain)s runs out on %(expires)s (days left: %(days)s)."
msgstr "Die Registrierung von %(domain)s läuft am %(expires)s ab (verbleibende Tage: %(days)s)."

#: app/rules/domain.py
msgid "Ask whether auto-renewal is on and who is responsible for the registration."
msgstr ""
"Fragen Sie nach, ob die automatische Verlängerung eingeschaltet ist und wer für die Registrierung"
" verantwortlich ist."

#: app/rules/domain.py
msgid "Days left"
msgstr "Verbleibende Tage"

#: app/rules/domain.py
msgid "Domain registered recently"
msgstr "Domain erst kürzlich registriert"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s was registered %(age)s days ago."
msgstr "%(domain)s wurde vor %(age)s Tagen registriert."

#: app/rules/domain.py
msgid "A young domain has no track record; check who the vendor is before relying on it."
msgstr ""
"Eine junge Domain hat keine Vorgeschichte; prüfen Sie, wer der Anbieter ist, bevor Sie sich "
"darauf verlassen."

#: app/rules/domain.py
msgid "Domain has no transfer lock"
msgstr "Domain ohne Transfer-Sperre"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s can be transferred to another registrar without a lock in the way."
msgstr "%(domain)s kann ohne Sperre zu einem anderen Registrar übertragen werden."

#: app/rules/domain.py
msgid "Ask the registrar to set the transfer lock (clientTransferProhibited)."
msgstr "Bitten Sie den Registrar, die Transfer-Sperre zu setzen (clientTransferProhibited)."

#: app/rules/domain.py
msgid "Public breach on record"
msgstr "Öffentlich bekanntes Datenleck"

#: app/rules/domain.py
#, python-format
msgid "Have I Been Pwned lists a breach of %(domain)s: %(title)s (%(breach_date)s)."
msgstr "Have I Been Pwned verzeichnet ein Datenleck von %(domain)s: %(title)s (%(breach_date)s)."

#: app/rules/domain.py
msgid ""
"Ask what happened, what was done about it and whether the data was protected (for example hashed "
"passwords)."
msgstr ""
"Fragen Sie nach, was geschehen ist, was dagegen getan wurde und ob die Daten geschützt waren (zum"
" Beispiel gehashte Passwörter)."

#: app/rules/domain.py
msgid "Data exposed"
msgstr "Offengelegte Daten"

#: app/rules/domain.py
msgid "Verified by HIBP"
msgstr "Von HIBP verifiziert"

#: app/rules/domain.py
msgid "Months ago"
msgstr "Monate her"

#: app/rules/domain.py
msgid "No security.txt"
msgstr "Keine security.txt"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s publishes no security.txt, so there is no stated way to report a vulnerability."
msgstr ""
"%(domain)s veröffentlicht keine security.txt, deshalb ist nicht angegeben, wie eine Schwachstelle"
" gemeldet werden kann."

#: app/rules/domain.py
msgid "Publish /.well-known/security.txt (RFC 9116) with a contact and an expiry date."
msgstr ""
"Veröffentlichen Sie /.well-known/security.txt (RFC 9116) mit einer Kontaktangabe und einem "
"Ablaufdatum."

#: app/rules/domain.py
msgid "security.txt is unusable"
msgstr "security.txt ist unbrauchbar"

#: app/rules/domain.py
#, python-format
msgid "The security.txt of %(domain)s has problems: %(problems)s."
msgstr "Die security.txt von %(domain)s hat Probleme: %(problems)s."

#: app/rules/domain.py
msgid "Keep security.txt current: a contact, a future expiry date, one Expires field."
msgstr ""
"Halten Sie die security.txt aktuell: eine Kontaktangabe, ein Ablaufdatum in der Zukunft, ein "
"einziges Feld Expires."

#: app/rules/domain.py
msgid "No CAA records"
msgstr "Keine CAA-Einträge"

#: app/rules/domain.py
#, python-format
msgid "%(domain)s has no CAA records, so any certificate authority may issue for it."
msgstr ""
"%(domain)s hat keine CAA-Einträge, deshalb darf jede Zertifizierungsstelle Zertifikate dafür "
"ausstellen."

#: app/rules/domain.py
msgid "Publish CAA records naming the certificate authorities you use."
msgstr "Veröffentlichen Sie CAA-Einträge, die die eingesetzten Zertifizierungsstellen nennen."

#: app/rules/domain.py
msgid "Name servers are not redundant"
msgstr "Nameserver sind nicht redundant"

#: app/rules/domain.py
#, python-format
msgid "The name servers of %(domain)s are not redundant: %(problems)s."
msgstr "Die Nameserver von %(domain)s sind nicht redundant: %(problems)s."

#: app/rules/domain.py
msgid "Use at least two name servers in different networks."
msgstr "Verwenden Sie mindestens zwei Nameserver in verschiedenen Netzwerken."

#: app/rules/domain.py
msgid "Name servers"
msgstr "Nameserver"

#: app/rules/domain.py app/rules/host.py
msgid "Problems"
msgstr "Probleme"

#: app/rules/domain.py app/rules/host.py app/templates/assessments/checks/registration.html
#: app/templates/assessments/checks/security_txt.html
msgid "Expires"
msgstr "Läuft ab"

#: app/rules/domain.py app/service/audit.py app/templates/accounts/index.html
#: app/templates/assessments/checks/breaches.html app/templates/components/nav.html
msgid "Accounts"
msgstr "Konten"

#: app/rules/domain.py app/templates/assessments/checks/email.html
msgid "DNS lookups"
msgstr "DNS-Abfragen"

#: app/rules/domain.py app/templates/assessments/checks/registration.html
msgid "Registered"
msgstr "Registriert"

#: app/rules/domain.py app/templates/assessments/checks/registration.html
msgid "Status flags"
msgstr "Status-Flags"

#: app/rules/domain.py app/templates/assessments/checks/security_txt.html
msgid "Found at"
msgstr "Gefunden unter"

#: app/rules/host.py
msgid "Certificate not valid"
msgstr "Zertifikat nicht gültig"

#: app/rules/host.py
#, python-format
msgid "The TLS certificate of %(host)s is not valid for clients: %(failures)s."
msgstr "Das TLS-Zertifikat von %(host)s ist für Clients nicht gültig: %(failures)s."

#: app/rules/host.py
msgid "Ask the vendor to replace the certificate and to monitor expiry and names."
msgstr "Bitten Sie den Anbieter, das Zertifikat zu ersetzen und Ablauf und Namen zu überwachen."

#: app/rules/host.py
msgid "Days remaining"
msgstr "Verbleibende Tage"

#: app/rules/host.py
msgid "Certificate expires soon"
msgstr "Zertifikat läuft bald ab"

#: app/rules/host.py
#, python-format
msgid "The TLS certificate of %(host)s expires in %(days)s days."
msgstr "Das TLS-Zertifikat von %(host)s läuft in %(days)s Tagen ab."

#: app/rules/host.py
msgid "Renewal should be automated; ask how certificate expiry is monitored."
msgstr ""
"Die Erneuerung sollte automatisiert sein; fragen Sie nach, wie der Ablauf von Zertifikaten "
"überwacht wird."

#: app/rules/host.py
msgid "Weak certificate key"
msgstr "Schwacher Zertifikatsschlüssel"

#: app/rules/host.py
#, python-format
msgid "The certificate of %(host)s uses a weak %(key_type)s key (%(key_bits)s bits)."
msgstr "Das Zertifikat von %(host)s verwendet einen schwachen %(key_type)s-Schlüssel (%(key_bits)s Bit)."

#: app/rules/host.py
msgid "Keys should be RSA with 2048 bits or more, or elliptic-curve (P-256 or better)."
msgstr "Schlüssel sollten RSA mit 2048 Bit oder mehr sein oder elliptische Kurven (P-256 oder besser)."

#: app/rules/host.py
msgid "Key type"
msgstr "Schlüsseltyp"

#: app/rules/host.py
msgid "Key size (bits)"
msgstr "Schlüsselgrösse (Bit)"

#: app/rules/host.py
msgid "Weak certificate signature"
msgstr "Schwache Zertifikatssignatur"

#: app/rules/host.py
#, python-format
msgid "The certificate of %(host)s is signed with the weak algorithm %(algorithm)s."
msgstr "Das Zertifikat von %(host)s ist mit dem schwachen Algorithmus %(algorithm)s signiert."

#: app/rules/host.py
msgid "Certificates must be signed with SHA-256 or stronger."
msgstr "Zertifikate müssen mit SHA-256 oder stärker signiert sein."

#: app/rules/host.py
msgid "Signature algorithm"
msgstr "Signaturalgorithmus"

#: app/rules/host.py
msgid "Outdated TLS versions accepted"
msgstr "Veraltete TLS-Versionen werden akzeptiert"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s still accepts %(versions)s next to the current versions. TLS 1.0 and 1.1 were retired in"
" 2021 (RFC 8996)."
msgstr ""
"%(host)s akzeptiert neben den aktuellen Versionen weiterhin %(versions)s. TLS 1.0 und 1.1 wurden "
"2021 ausgemustert (RFC 8996)."

#: app/rules/host.py
msgid "Switch off TLS 1.0 and TLS 1.1 so that only TLS 1.2 and TLS 1.3 are accepted."
msgstr "Schalten Sie TLS 1.0 und TLS 1.1 aus, damit nur TLS 1.2 und TLS 1.3 akzeptiert werden."

#: app/rules/host.py
msgid "Outdated versions accepted"
msgstr "Akzeptierte veraltete Versionen"

#: app/rules/host.py
msgid "Current versions accepted"
msgstr "Akzeptierte aktuelle Versionen"

#: app/rules/host.py
msgid "Only outdated TLS versions accepted"
msgstr "Nur veraltete TLS-Versionen werden akzeptiert"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s accepts %(versions)s and refuses TLS 1.2 and TLS 1.3: current browsers and libraries "
"cannot connect securely."
msgstr ""
"%(host)s akzeptiert %(versions)s und lehnt TLS 1.2 und TLS 1.3 ab: Aktuelle Browser und "
"Bibliotheken können keine sichere Verbindung aufbauen."

#: app/rules/host.py
msgid "Enable TLS 1.2 and TLS 1.3 and switch off TLS 1.0 and TLS 1.1."
msgstr "Aktivieren Sie TLS 1.2 und TLS 1.3 und schalten Sie TLS 1.0 und TLS 1.1 aus."

#: app/rules/host.py
msgid "Versions accepted"
msgstr "Akzeptierte Versionen"

#: app/rules/host.py
msgid "TLS 1.3 not offered"
msgstr "TLS 1.3 wird nicht angeboten"

#: app/rules/host.py
#, python-format
msgid "%(host)s accepts TLS 1.2 but not TLS 1.3."
msgstr "%(host)s akzeptiert TLS 1.2, aber nicht TLS 1.3."

#: app/rules/host.py
msgid ""
"Enable TLS 1.3 when the server software supports it: it is faster and drops the weak options of "
"older versions. Not urgent."
msgstr ""
"Aktivieren Sie TLS 1.3, sobald die Server-Software es unterstützt: Es ist schneller und lässt die"
" schwachen Optionen älterer Versionen weg. Nicht dringend."

#: app/rules/host.py
msgid "Suites without encryption or authentication accepted"
msgstr "Cipher Suites ohne Verschlüsselung oder Authentifizierung werden akzeptiert"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s accepts the cipher suite %(cipher)s, which has no encryption or no authentication of the"
" server."
msgstr ""
"%(host)s akzeptiert die Cipher Suite %(cipher)s, die keine Verschlüsselung oder keine "
"Authentifizierung des Servers bietet."

#: app/rules/host.py
msgid ""
"Remove NULL and anonymous cipher suites from the server's configuration: with them traffic can be"
" read, or anyone can pose as the server."
msgstr ""
"Entfernen Sie NULL- und anonyme Cipher Suites aus der Konfiguration des Servers: Mit ihnen kann "
"der Datenverkehr mitgelesen werden, oder jemand kann sich als der Server ausgeben."

#: app/rules/host.py
msgid "Suite without forward secrecy chosen"
msgstr "Cipher Suite ohne Forward Secrecy gewählt"

#: app/rules/host.py
#, python-format
msgid ""
"In a TLS 1.2 handshake %(host)s chose %(cipher)s, a suite that gives no forward secrecy, although"
" better ones were offered."
msgstr ""
"In einem TLS-1.2-Handshake wählte %(host)s %(cipher)s, eine Cipher Suite ohne Forward Secrecy, "
"obwohl bessere angeboten wurden."

#: app/rules/host.py
msgid ""
"Put the ECDHE suites first in the server's preference order, so that a stolen server key cannot "
"open recorded sessions."
msgstr ""
"Setzen Sie die ECDHE-Suites in der Rangfolge des Servers an die erste Stelle, damit ein "
"gestohlener Serverschlüssel aufgezeichnete Sitzungen nicht öffnen kann."

#: app/rules/host.py
msgid "No HTTPS"
msgstr "Kein HTTPS"

#: app/rules/host.py
#, python-format
msgid "%(host)s answers on plain HTTP but offers no HTTPS."
msgstr "%(host)s antwortet über reines HTTP, bietet aber kein HTTPS an."

#: app/rules/host.py
msgid "Ask the vendor to serve the site over HTTPS only."
msgstr "Bitten Sie den Anbieter, die Website nur über HTTPS auszuliefern."

#: app/rules/host.py
msgid "Why HTTPS failed"
msgstr "Warum HTTPS fehlgeschlagen ist"

#: app/rules/host.py
msgid "HTTP is not redirected to HTTPS"
msgstr "HTTP wird nicht auf HTTPS weitergeleitet"

#: app/rules/host.py
#, python-format
msgid "%(host)s serves content over plain HTTP instead of redirecting to HTTPS."
msgstr "%(host)s liefert Inhalte über reines HTTP aus, statt auf HTTPS weiterzuleiten."

#: app/rules/host.py
msgid "Port 80 should redirect to HTTPS (or be closed)."
msgstr "Port 80 sollte auf HTTPS weiterleiten (oder geschlossen sein)."

#: app/rules/host.py
msgid "Status on port 80"
msgstr "Status auf Port 80"

#: app/rules/host.py
msgid "HSTS not set"
msgstr "HSTS nicht gesetzt"

#: app/rules/host.py
#, python-format
msgid "%(host)s does not send a Strict-Transport-Security header."
msgstr "%(host)s sendet keinen Strict-Transport-Security-Header."

#: app/rules/host.py
msgid "Send Strict-Transport-Security so browsers stay on HTTPS."
msgstr "Senden Sie Strict-Transport-Security, damit Browser bei HTTPS bleiben."

#: app/rules/host.py
msgid "HSTS lifetime is short"
msgstr "HSTS-Gültigkeitsdauer ist kurz"

#: app/rules/host.py
#, python-format
msgid "The Strict-Transport-Security lifetime of %(host)s is %(max_age)s seconds."
msgstr "Die Strict-Transport-Security-Gültigkeitsdauer von %(host)s beträgt %(max_age)s Sekunden."

#: app/rules/host.py
msgid "Use a max-age of at least six months (15552000 seconds)."
msgstr "Verwenden Sie ein max-age von mindestens sechs Monaten (15552000 Sekunden)."

#: app/rules/host.py
msgid "max-age (seconds)"
msgstr "max-age (Sekunden)"

#: app/rules/host.py
msgid "No Content-Security-Policy"
msgstr "Keine Content-Security-Policy"

#: app/rules/host.py
#, python-format
msgid "%(host)s does not send a Content-Security-Policy header."
msgstr "%(host)s sendet keinen Content-Security-Policy-Header."

#: app/rules/host.py
msgid "A Content-Security-Policy limits the damage of injected scripts."
msgstr "Eine Content-Security-Policy begrenzt den Schaden eingeschleuster Skripte."

#: app/rules/host.py
msgid "No X-Content-Type-Options"
msgstr "Kein X-Content-Type-Options"

#: app/rules/host.py
#, python-format
msgid "%(host)s does not send X-Content-Type-Options: nosniff."
msgstr "%(host)s sendet kein X-Content-Type-Options: nosniff."

#: app/rules/host.py
msgid "Send X-Content-Type-Options: nosniff so browsers do not guess content types."
msgstr "Senden Sie X-Content-Type-Options: nosniff, damit Browser Inhaltstypen nicht erraten."

#: app/rules/host.py
msgid "No clickjacking protection"
msgstr "Kein Clickjacking-Schutz"

#: app/rules/host.py
#, python-format
msgid "%(host)s sets neither X-Frame-Options nor a CSP frame-ancestors directive."
msgstr "%(host)s setzt weder X-Frame-Options noch eine CSP-Direktive frame-ancestors."

#: app/rules/host.py
msgid "Forbid framing with X-Frame-Options or Content-Security-Policy: frame-ancestors."
msgstr ""
"Verbieten Sie das Einbetten in Frames mit X-Frame-Options oder Content-Security-Policy: frame-"
"ancestors."

#: app/rules/host.py
msgid "Session cookie without protection flags"
msgstr "Sitzungs-Cookie ohne Schutz-Flags"

#: app/rules/host.py
#, python-format
msgid "%(host)s sets session-like cookies without the Secure or HttpOnly flag: %(cookies)s."
msgstr "%(host)s setzt sitzungsähnliche Cookies ohne das Flag Secure oder HttpOnly: %(cookies)s."

#: app/rules/host.py
msgid "Session cookies should be Secure and HttpOnly (and carry a SameSite attribute)."
msgstr "Sitzungs-Cookies sollten Secure und HttpOnly sein (und ein SameSite-Attribut tragen)."

#: app/rules/host.py
msgid "Without Secure"
msgstr "Ohne Secure"

#: app/rules/host.py
msgid "Without HttpOnly"
msgstr "Ohne HttpOnly"

#: app/rules/host.py
msgid "Software version disclosed"
msgstr "Software-Version offengelegt"

#: app/rules/host.py
#, python-format
msgid "%(host)s reveals software versions in its response headers: %(versions)s."
msgstr "%(host)s gibt in seinen Antwort-Headern Software-Versionen preis: %(versions)s."

#: app/rules/host.py
msgid "Hide version numbers from Server and X-Powered-By; they help attackers."
msgstr "Blenden Sie Versionsnummern in Server und X-Powered-By aus; sie helfen Angreifern."

#: app/rules/host.py
msgid "Old software version"
msgstr "Alte Software-Version"

#: app/rules/host.py
#, python-format
msgid "%(host)s shows software that is old: %(outdated)s."
msgstr "%(host)s zeigt Software, die veraltet ist: %(outdated)s."

#: app/rules/host.py
msgid ""
"Find out which version really runs and whether it still receives security fixes, and update what "
"has reached its end of life. A version that only a server header or a file name shows can be "
"patched without changing the number, or be wrong, so ask rather than assume."
msgstr ""
"Finden Sie heraus, welche Version tatsächlich läuft und ob sie noch Sicherheitskorrekturen "
"erhält, und aktualisieren Sie, was sein Lebensende erreicht hat. Eine Version, die nur ein "
"Server-Header oder ein Dateiname zeigt, kann gepatcht sein, ohne dass sich die Nummer ändert, "
"oder falsch sein; fragen Sie deshalb nach, statt anzunehmen."

#: app/rules/host.py
msgid "Software"
msgstr "Software"

#: app/rules/host.py
msgid "What is known"
msgstr "Was bekannt ist"

#: app/rules/host.py
msgid "Version read from"
msgstr "Version gelesen aus"

#: app/rules/host.py
msgid "Page loads from a host that served malware"
msgstr "Seite lädt von einem Host, der Malware ausgeliefert hat"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s loads content from %(flagged)s, which is known to have served malicious code to the "
"visitors of the pages that load from it."
msgstr ""
"%(host)s lädt Inhalte von %(flagged)s, das bekanntermassen schädlichen Code an die Besucher der "
"Seiten ausgeliefert hat, die davon laden."

#: app/rules/host.py
msgid ""
"Remove the reference, or replace it with a copy of the file that the site serves itself or with a"
" trusted mirror, and review what the page loaded in the meantime. Whoever controls such a host "
"can run code in every visitor's browser."
msgstr ""
"Entfernen Sie den Verweis oder ersetzen Sie ihn durch eine Kopie der Datei, die die Website "
"selbst ausliefert, oder durch einen vertrauenswürdigen Mirror, und prüfen Sie, was die Seite in "
"der Zwischenzeit geladen hat. Wer einen solchen Host kontrolliert, kann im Browser jedes "
"Besuchers Code ausführen."

#: app/rules/host.py
msgid "Loaded as"
msgstr "Geladen als"

#: app/rules/host.py
msgid "Blocked by security DNS resolvers"
msgstr "Von Sicherheits-DNS-Resolvern blockiert"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s is blocked by %(blocked_by)s, which refuse names that their threat intelligence flags as"
" malicious."
msgstr ""
"%(host)s wird von %(blocked_by)s blockiert; diese lehnen Namen ab, die ihre Threat Intelligence "
"als bösartig einstuft."

#: app/rules/host.py
msgid ""
"Find out what the host serves and who controls it: a compromised site, a taken-over subdomain or "
"a phishing page under the vendor's name are all possible. Ask the vendor whether they know. If "
"the name is blocked by mistake, the resolvers' operators have a way to ask for a review."
msgstr ""
"Finden Sie heraus, was der Host ausliefert und wer ihn kontrolliert: Eine kompromittierte "
"Website, eine übernommene Subdomain oder eine Phishing-Seite unter dem Namen des Anbieters sind "
"alle möglich. Fragen Sie den Anbieter, ob er davon weiss. Wird der Name irrtümlich blockiert, "
"können die Betreiber der Resolver um eine Überprüfung gebeten werden."

#: app/rules/host.py
msgid "Blocked by"
msgstr "Blockiert von"

#: app/rules/host.py
msgid "How it shows"
msgstr "Woran es sich zeigt"

#: app/rules/host.py
msgid "Resolvers asked"
msgstr "Befragte Resolver"

#: app/rules/host.py
msgid "Host name on a blocklist"
msgstr "Hostname auf einer Blockliste"

#: app/rules/host.py
#, python-format
msgid "%(host)s is listed by %(lists)s for %(listed_for)s."
msgstr "%(host)s ist bei %(lists)s gelistet (Grund: %(listed_for)s)."

#: app/rules/host.py
msgid ""
"Find out what the host serves and who controls it: a compromised site, a taken-over subdomain or "
"a phishing page under the vendor's name are all possible. Ask the vendor whether they know and "
"what they did about it. A listing can be out of date or mistaken; the maintainers of the list "
"have a way to ask for a review."
msgstr ""
"Finden Sie heraus, was der Host ausliefert und wer ihn kontrolliert: Eine kompromittierte "
"Website, eine übernommene Subdomain oder eine Phishing-Seite unter dem Namen des Anbieters sind "
"alle möglich. Fragen Sie den Anbieter, ob er davon weiss und was er dagegen getan hat. Ein "
"Eintrag kann veraltet oder irrtümlich sein; die Betreiber der Liste bieten eine Möglichkeit, um "
"eine Überprüfung zu bitten."

#: app/rules/host.py
msgid "Listed by"
msgstr "Gelistet bei"

#: app/rules/host.py
msgid "Listed for"
msgstr "Grund der Listung"

#: app/rules/host.py
msgid "Alias of a blocklisted host"
msgstr "Alias eines Hosts auf einer Blockliste"

#: app/rules/host.py
#, python-format
msgid "%(host)s is an alias for %(listed)s, which is listed by %(lists)s for %(listed_for)s."
msgstr "%(host)s ist ein Alias für %(listed)s, der bei %(lists)s gelistet ist (Grund: %(listed_for)s)."

#: app/rules/host.py
msgid ""
"Ask the vendor why the name points there. An alias to a host that serves malware or phishing is "
"either a leftover that someone else has since taken over, or a sign that the vendor's DNS was "
"changed. Remove the alias if nothing needs it. What the listed host serves under this name is not"
" known."
msgstr ""
"Fragen Sie den Anbieter, warum der Name dorthin zeigt. Ein Alias auf einen Host, der Malware oder"
" Phishing ausliefert, ist entweder ein Überbleibsel, das inzwischen jemand anderes übernommen "
"hat, oder ein Zeichen dafür, dass das DNS des Anbieters verändert wurde. Entfernen Sie den Alias,"
" wenn ihn niemand braucht. Was der gelistete Host unter diesem Namen ausliefert, ist nicht "
"bekannt."

#: app/rules/host.py
msgid "Listed alias"
msgstr "Gelisteter Alias"

#: app/rules/host.py
msgid "Address on a blocklist"
msgstr "Adresse auf einer Blockliste"

#: app/rules/host.py
#, python-format
msgid "%(host)s resolves to %(addresses)s, which is listed by %(lists)s for %(listed_for)s."
msgstr "%(host)s wird zu %(addresses)s aufgelöst; gelistet bei %(lists)s (Grund: %(listed_for)s)."

#: app/rules/host.py
msgid ""
"Find out whether the address is the vendor's own server or shared with others. An address that a "
"botnet or malware list names can mean that the server behind it is compromised; one on a phishing"
" list may belong to a neighbour on shared hosting. Ask the vendor to look at the server."
msgstr ""
"Finden Sie heraus, ob die Adresse der eigene Server des Anbieters ist oder mit anderen geteilt "
"wird. Eine Adresse, die eine Botnet- oder Malware-Liste nennt, kann bedeuten, dass der Server "
"dahinter kompromittiert ist; eine auf einer Phishing-Liste gehört möglicherweise einem Nachbarn "
"auf einem Shared Hosting. Bitten Sie den Anbieter, sich den Server anzusehen."

#: app/rules/host.py
msgid "Listed addresses"
msgstr "Gelistete Adressen"

#: app/rules/host.py
msgid "Alias points nowhere"
msgstr "Alias zeigt ins Leere"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s is an alias for %(target)s, which does not exist; if the target can be claimed, the name"
" can be taken over."
msgstr ""
"%(host)s ist ein Alias für %(target)s; dieses Ziel existiert nicht. Kann es beansprucht werden, "
"lässt sich der Name übernehmen."

#: app/rules/host.py
msgid "Remove the alias, or check that the target cannot be registered by someone else."
msgstr ""
"Entfernen Sie den Alias oder prüfen Sie, dass das Ziel nicht von jemand anderem registriert "
"werden kann."

#: app/rules/host.py
msgid "Missing target"
msgstr "Fehlendes Ziel"

#: app/rules/host.py
msgid "Alias may be taken over"
msgstr "Alias kann übernommen werden"

#: app/rules/host.py
#, python-format
msgid ""
"%(host)s is an alias for %(target)s at %(service)s, and the name behind it looks unclaimed: "
"%(takeover_how)s."
msgstr ""
"%(host)s ist ein Alias für %(target)s bei %(service)s, und der Name dahinter wirkt unbeansprucht:"
" %(takeover_how)s."

#: app/rules/host.py
msgid ""
"Remove the DNS record if the alias is no longer needed, or create the resource at the service "
"again before somebody else does. Ask the vendor how its aliases are reviewed when a service is "
"switched off."
msgstr ""
"Entfernen Sie den DNS-Eintrag, wenn der Alias nicht mehr gebraucht wird, oder legen Sie die "
"Ressource beim Dienst erneut an, bevor es jemand anderes tut. Fragen Sie den Anbieter, wie seine "
"Aliasse überprüft werden, wenn ein Dienst abgeschaltet wird."

#: app/rules/host.py
msgid "HTTP status"
msgstr "HTTP-Status"

#: app/rules/host.py
msgid "The page says"
msgstr "Die Seite sagt"

#: app/rules/host.py
msgid "Can a stranger claim the name?"
msgstr "Kann der Name von Dritten beansprucht werden?"

#: app/rules/host.py
msgid "Also an alias for"
msgstr "Auch ein Alias für"

#: app/rules/host.py
msgid "Public name points to a private address"
msgstr "Öffentlicher Name zeigt auf eine private Adresse"

#: app/rules/host.py
#, python-format
msgid "%(host)s resolves to non-public addresses: %(addresses)s."
msgstr "%(host)s wird zu nicht öffentlichen Adressen aufgelöst: %(addresses)s."

#: app/rules/host.py
msgid "Public DNS should not publish internal addresses; they reveal the network layout."
msgstr ""
"Öffentliches DNS sollte keine internen Adressen veröffentlichen; sie verraten den Aufbau des "
"Netzwerks."

#: app/rules/host.py
msgid "Host located outside the allowed area"
msgstr "Host ausserhalb des erlaubten Bereichs"

#: app/rules/host.py
#, python-format
msgid "%(host)s resolves to an address located in %(countries)s, outside the allowed area."
msgstr "%(host)s wird zu einer Adresse in %(countries)s aufgelöst, ausserhalb des erlaubten Bereichs."

#: app/rules/host.py
msgid ""
"Ask the vendor where the data is processed and stored; the address location is only a first "
"indication."
msgstr ""
"Fragen Sie den Anbieter, wo die Daten verarbeitet und gespeichert werden; der Standort der "
"Adresse ist nur ein erster Hinweis."

#: app/rules/host.py app/service/audit.py app/templates/assessments/_scan_panel.html
#: app/templates/assessments/delete.html app/templates/assessments/history.html
#: app/templates/assessments/report.html
msgid "Hosts"
msgstr "Hosts"

#: app/rules/host.py app/templates/assessments/_summary.html
msgid "Countries"
msgstr "Länder"

#: app/rules/host.py app/templates/assessments/checks/domain_dns.html
#: app/templates/assessments/report.html
msgid "Addresses"
msgstr "Adressen"

#: app/rules/host.py app/templates/assessments/checks/ports.html
msgid "Service"
msgstr "Dienst"

#: app/rules/host.py app/templates/assessments/checks/takeover.html
msgid "Alias for"
msgstr "Alias für"

#: app/rules/host.py app/templates/assessments/checks/tls_protocols.html
msgid "Suite it chose"
msgstr "Gewählte Cipher Suite"

#: app/rules/ip.py
msgid "Risky service reachable from the internet"
msgstr "Riskanter Dienst aus dem Internet erreichbar"

#: app/rules/ip.py
#, python-format
msgid "A scanner saw %(service)s (port %(port)s) open on %(ip)s."
msgstr "Ein Scanner sah %(service)s (Port %(port)s) offen auf %(ip)s."

#: app/rules/ip.py
msgid ""
"Databases, remote administration and file sharing should not be reachable from the internet; ask "
"the vendor to restrict them."
msgstr ""
"Datenbanken, Fernadministration und Dateifreigabe sollten nicht aus dem Internet erreichbar sein;"
" bitten Sie den Anbieter, sie einzuschränken."

#: app/rules/ip.py
msgid "Hosts on this address"
msgstr "Hosts auf dieser Adresse"

#: app/rules/ip.py
msgid "Product"
msgstr "Produkt"

#: app/rules/ip.py
msgid "Known vulnerabilities reported"
msgstr "Bekannte Schwachstellen gemeldet"

#: app/rules/ip.py
#, python-format
msgid ""
"%(count)s CVEs are reported for software seen on %(ip)s; they are leads to verify, not confirmed "
"vulnerabilities."
msgstr ""
"Für Software auf %(ip)s werden %(count)s CVEs gemeldet; es sind Hinweise zur Überprüfung, keine "
"bestätigten Schwachstellen."

#: app/rules/ip.py
msgid ""
"Ask the vendor which of these apply and how patching is tracked, starting with the ones that are "
"known to be exploited."
msgstr ""
"Fragen Sie den Anbieter, welche davon zutreffen und wie das Patchen verfolgt wird, beginnend mit "
"denen, von denen bekannt ist, dass sie ausgenutzt werden."

#: app/rules/ip.py
msgid "Examples"
msgstr "Beispiele"

