#: app/templates/security/two_factor_setup.html app/templates/security/two_factor_verify_code.html
msgid "Start again"
msgstr "Neu starten"

#: app/templates/security/two_factor_setup.html app/templates/security/two_factor_verify_code.html
msgid "to get a new code."
msgstr "für einen neuen Code."

#: app/templates/security/two_factor_verify_code.html
msgid "Enter the code that your authenticator app shows to finish the setup."
msgstr "Geben Sie den Code ein, den Ihre Authenticator-App anzeigt, um die Einrichtung abzuschliessen."

#: app/templates/security/two_factor_verify_code.html
msgid "Enter the code from your authenticator app."
msgstr "Geben Sie den Code aus Ihrer Authenticator-App ein."

#: app/templates/security/two_factor_verify_code.html
msgid "Lost your authenticator? Ask an administrator to reset it."
msgstr "Authenticator verloren? Bitten Sie einen Admin, ihn zurückzusetzen."

#: app/templates/security/verify.html
msgid "Confirm your password"
msgstr "Passwort bestätigen"

#: app/templates/security/verify.html
msgid "Enter your password again to continue."
msgstr "Geben Sie Ihr Passwort erneut ein, um fortzufahren."

#: app/templates/security/verify.html
msgid "Continue"
msgstr "Weiter"

#: app/web.py
msgid "Request not accepted"
msgstr "Anfrage nicht akzeptiert"

#: app/web.py
msgid "The request could not be processed. Reload the page and retry."
msgstr "Die Anfrage konnte nicht verarbeitet werden. Laden Sie die Seite neu und versuchen Sie es erneut."

#: app/web.py
msgid "Sign in required"
msgstr "Anmeldung erforderlich"

#: app/web.py
msgid "Please sign in to continue."
msgstr "Bitte melden Sie sich an, um fortzufahren."

#: app/web.py
msgid "Access denied"
msgstr "Zugriff verweigert"

#: app/web.py
msgid "You do not have access to this page."
msgstr "Sie haben keinen Zugriff auf diese Seite."

#: app/web.py
msgid "This page does not exist, or you do not have access to it."
msgstr "Diese Seite existiert nicht, oder Sie haben keinen Zugriff darauf."

#: app/web.py
msgid "Method not allowed"
msgstr "Methode nicht erlaubt"

#: app/web.py
msgid "This action is not available here."
msgstr "Diese Aktion ist hier nicht verfügbar."

#: app/web.py
msgid "Request too large"
msgstr "Anfrage zu gross"

#: app/web.py
msgid ""
"The request was larger than this installation accepts. If you were sending a picture, choose a "
"smaller one."
msgstr ""
"Die Anfrage war grösser, als diese Installation akzeptiert. Wenn Sie ein Bild gesendet haben, "
"wählen Sie ein kleineres."

#: app/web.py
msgid "Too many attempts"
msgstr "Zu viele Versuche"

#: app/web.py
msgid "Sign-in is paused after repeated failed attempts."
msgstr "Die Anmeldung ist nach mehreren fehlgeschlagenen Versuchen pausiert."

#: app/web.py
msgid "Something went wrong"
msgstr "Etwas ist schiefgelaufen"

#: app/web.py
msgid "The request could not be completed."
msgstr "Die Anfrage konnte nicht abgeschlossen werden."

