#, python-format
msgid "Gaprism · report of %(domain)s · scan of %(scan)s · generated %(when)s"
msgstr "Gaprism · Bericht zu %(domain)s · Scan vom %(scan)s · erstellt am %(when)s"

#: app/templates/assessments/report.html app/templates/layout.html
msgid "Technical due diligence"
msgstr "Technische Due Diligence"

#: app/templates/audit/index.html
