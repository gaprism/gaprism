# What the image build gets to see. Keep secrets and local data out of the build context: a
# COPY can only copy what is in it, so a file listed here can never end up in an image layer.

# Secrets and settings (the template .env.example stays)
.env
.env.*
!.env.example

# Local data: IP location databases, evidence, scratch files
var
tmp
*.mmdb
*.mmdb.gz

# Dependencies and caches (the Dockerfile installs its own)
.venv
node_modules
__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Version control, CI and editor or agent tooling
.git
.github
.idea
.vscode
.junie
.aiassistant
.claude

# Not needed to run the application
tests
docs
*.log
