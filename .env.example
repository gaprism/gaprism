# Copy to .env (git-ignored) and fill in. Never commit real values.
# `flask` loads .env automatically; pytest reads TEST_DATABASE_URL from it.

# --- Secrets (production needs long random values; weak ones are rejected at startup) ---
SECRET_KEY=
SECURITY_PASSWORD_SALT=
MFA_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/due_diligence
# The test run creates and drops its own schema; the database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/due_diligence_test
# Optional. Use a dedicated schema when the role cannot write to `public` (shared servers).
# `flask db upgrade` creates it. Leave empty to use the server default.
DB_SCHEMA=

# --- IP location data (DB-IP Lite, installed by `flask datasets update`) ---
# Where the databases live (default: var/datasets in the project folder).
# DATASETS_DIR=

# --- DNS and the network towards assessed hosts ---
# Resolvers the DNS check asks (comma-separated IPs); `system` uses the operating system's.
EGRESS_DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT_SECONDS=5
# TLS and HTTP checks: seconds to connect, and to wait for a response.
EGRESS_CONNECT_TIMEOUT_SEC=10
EGRESS_READ_TIMEOUT_SEC=20

# --- Worker (`flask worker`) ---
# Checks run at the same time, and how many of them may belong to one scan (= one assessed domain).
WORKER_THREADS=8
PER_TARGET_CONCURRENCY=4

# --- Certificate Transparency discovery ---
# Sources in the order they are asked: ctlogs (ctlogs.dev), certspotter, crtsh.
CT_SOURCES=ctlogs,certspotter,crtsh
# union = ask every source and merge (best coverage); first = stop at the first that answers.
CT_MODE=union
# Union mode asks the sources at the same time; one that is still silent after this many seconds
# is reported as "took too long" instead of holding the scan up.
DISCOVERY_BUDGET_SECONDS=45

# --- Optional provider keys; empty means keyless access (rate limited) ---
# A free ctlogs.dev key is for non-commercial use; paid plans cover commercial use.
CTLOGS_API_KEY=
CERTSPOTTER_TOKEN=
SHODAN_API_KEY=

# --- Limits and policy (defaults shown) ---
# MAX_HOSTS_PER_RUN=200
# BLOCKED_DOMAINS=corp.example,intranet.example
# REQUIRE_MFA=true
